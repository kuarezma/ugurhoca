# ----------------------------------------------------------------------
# UĞUR HOCA (.htaccess) CACHE-CONTROL VE PERFORMANS YÖNERGELERİ
# ----------------------------------------------------------------------

<IfModule mod_headers.c>
  # 1. Hashed JS/CSS ve Statik Varlıklar (1 Yıl Immutable)
  <FilesMatch "\.(css|js|woff2|woff|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # 2. Görseller ve Medya Dosyaları (30 Günlük + SWR)
  <FilesMatch "\.(ico|jpg|jpeg|png|webp|avif|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # 3. HTML Sayfaları ve Dinamik Çıktılar (BFCache Uyumlu SWR + İzolasyon Başlıkları)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=0, must-revalidate, stale-while-revalidate=60"
    Header set X-Content-Type-Options "nosniff"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "credentialless"
  </FilesMatch>

  # 4. JSON ve Speculation Kuralları
  <FilesMatch "\.(json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Brotli ve Gzip Sıkıştırma
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
