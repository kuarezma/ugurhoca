{
  "name": "matematik-platform",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS=1 next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:db": "node scripts/test-database.mjs",
    "test:fast": "vitest run",
    "test:contrast": "playwright test e2e/contrast.spec.ts",
    "test:e2e": "playwright test",
    "start": "next start",
    "setup:env": "bash scripts/bootstrap-env.sh",
    "preview:annual-plan": "node scripts/preview-annual-plan.mjs",
    "prepare:annual-plan": "node scripts/meb-annual-plan-to-csv.mjs data/annual-plan/2026-2027.xlsx ../yillik-plan-2026-2027.csv",
    "import:annual-plan": "tsx scripts/import-annual-plan.ts",
    "setup:worksheets:sql": "node scripts/build-worksheet-automation-sql.mjs",
    "setup:worksheets:check": "node scripts/check-worksheet-automation-setup.mjs",
    "setup:worksheets:source": "node scripts/check-worksheet-source-live.mjs",
    "analyze": "cross-env ANALYZE=true ANALYZE_OPEN=false next build --webpack",
    "analyze:compare": "node scripts/bundle-analyze-compare.mjs",
    "fetch:lgs": "python3 scripts/fetch-lgs-targets.py",
    "fetch:yks": "python3 scripts/fetch-yks-targets.py",
    "import:lgs": "node scripts/import-lgs-targets.mjs",
    "import:yks": "node scripts/import-yks-targets.mjs",
    "import:lgs:dry": "node scripts/import-lgs-targets.mjs --dry-run",
    "import:yks:dry": "node scripts/import-yks-targets.mjs --dry-run",
    "migrate:worksheets": "node scripts/migrate-worksheet-hierarchy.mjs",
    "migrate:worksheets:dry": "node scripts/migrate-worksheet-hierarchy.mjs --dry-run"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.26",
    "@livekit/components-styles": "^1.2.0",
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/speed-insights": "^2.1.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.18",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "livekit-client": "^2.25.0",
    "livekit-server-sdk": "^2.20.1",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "resend": "^6.39.0",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.0.8",
    "autoprefixer": "^10.7.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
