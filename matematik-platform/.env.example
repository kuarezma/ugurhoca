# Supabase Configuration
# Gerçek değerleri buraya YAZMAYIN — .env.local kullanın (./scripts/bootstrap-env.sh)
# GitHub Actions: aynı iki değişkeni Repository Secrets olarak ekleyin (docs/GITHUB_CI.md).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for import scripts + /api/chat-register (sohbet girişi). Server-only; Vercel'e ekleyin.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Yaprak test adayı arama kaynakları.
# Virgülle ayrılmış izinli sayfa veya PDF URL listesi girin.
WORKSHEET_CANDIDATE_SOURCE_URLS=
WORKSHEET_CANDIDATE_ALLOWED_HOSTS=

# Vercel Cron endpoint'leri için server-only gizli anahtar.
CRON_SECRET=change-this-cron-secret

# Google Drive OAuth (admin PDF kopyalama paketleri için)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/admin-google-drive/callback

# E-posta bildirimleri (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Varsayılan admin adresi koda gömülüdür (src/lib/admin.ts).
# Ek admin adresleri virgülle ayrılmış olarak buraya yazılır. Server-only.
ADMIN_EXTRA_EMAILS=

# Canlı ders (LiveKit)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Canlı ders güvenlik anahtarları. Server-only, uzun ve rastgele seçin.
LESSON_TEACHER_SECRET=
LESSON_PERSIST_SIGNING_SECRET=

# Canlı derste öğrenci katılımının öğretmen onayı gerektirip gerektirmediği.
# Onayı kapatmak için "false" yazın; boş bırakılırsa onay zorunludur.
NEXT_PUBLIC_REQUIRE_STUDENT_APPROVAL=

# Canlı derste engellenecek öğrenci adları (virgülle ayrılmış).
LESSON_STUDENT_NAME_BLOCKLIST=

# Görsel proxy ve toplu soru içe aktarma için izinli host listeleri (virgülle ayrılmış).
# Boş bırakılırsa koddaki varsayılan liste kullanılır.
IMAGE_PROXY_ALLOWED_HOSTS=
BUNDLE_IMPORT_ALLOWED_HOSTS=

# YALNIZCA yerel geliştirme: öğretmen kimlik doğrulamasını atlar.
# NODE_ENV=development dışında hiçbir etkisi yoktur; production'a eklemeyin.
ALLOW_INSECURE_TEACHER=
