# ----------------------------------------------------------------------
# UĞUR HOCA NGINX REVERSE PROXY, HTTP/3 (QUIC), ZSTD VE CACHE DİREKTİFLERİ
# ----------------------------------------------------------------------

# Zstandard (zstd), Brotli ve Gzip Modern Sıkıştırma Yapılandırması
# (nginx-module-zstd yüklü ise zstd aktifleşir; değilse brotli/gzip yedekleme devrededir)
zstd on;
zstd_comp_level 3;
zstd_types text/plain text/css text/xml application/javascript application/json application/xml+rss application/atom+xml image/svg+xml;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_types text/plain text/css text/xml application/javascript application/json application/xml+rss application/atom+xml image/svg+xml;

# HTTP/3 (QUIC) ve 0-RTT Erken Veri Ayarları (Server bloğunda kullanılmak üzere)
# listen 443 quic reuseport;
# listen 443 ssl;
# ssl_early_data on;
# ssl_protocols TLSv1.2 TLSv1.3;
# add_header Alt-Svc 'h3=":443"; ma=86400';
# proxy_set_header Early-Data $ssl_early_data;

# 1. Next.js Hashed Statik Dosyalar (1 Yıl Değişmez Önbellek)
location /_next/static/ {
    alias /var/www/ugurhoca/matematik-platform/.next/static/;
    expires 365d;
    access_log off;
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header Access-Control-Allow-Origin "*";
    add_header Alt-Svc 'h3=":443"; ma=86400';
}

# 2. Resimler, İkonlar ve Fontlar (30 Günlük + SWR)
location ~* \.(?:ico|png|jpg|jpeg|webp|avif|svg|woff2|woff)$ {
    expires 30d;
    access_log off;
    add_header Cache-Control "public, max-age=2592000, stale-while-revalidate=86400";
    add_header X-Content-Type-Options "nosniff";
    add_header Alt-Svc 'h3=":443"; ma=86400';
}

# 3. HTML Sayfaları ve Dinamik Proxy Geçişi (BFCache Uyumlu SWR + COOP/COEP İzolasyonu)
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection 'upgrade';
    proxy_set_header Host $host;
    proxy_cache_bypass $http_upgrade;

    # HTTP/3 Bildirimi
    add_header Alt-Svc 'h3=":443"; ma=86400' always;

    # HTML sayfalarının istemcide taze kalmasını ve anında arka plan doğrulamasını sağlar
    add_header Cache-Control "public, max-age=0, must-revalidate, stale-while-revalidate=60" always;

    # Çapraz Orijin İzolasyonu (Cross-Origin Isolation: COOP & COEP)
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "credentialless" always;
}
